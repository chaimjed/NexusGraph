# ---------- LLM (default: Google Gemini free tier, no credit card) ----------
# 1) Get a free key at https://aistudio.google.com  ->  "Get API key"
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model ids change often. If you get a 404, open AI Studio and copy a current Flash / Flash-Lite model id.
LLM_MODEL=gemini-flash-latest

# --- Alternative: fully local & free with Ollama (run `ollama pull llama3.1` first) ---
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# --- Alternative: Groq / OpenRouter free models: set their OpenAI-compatible base URL, key and a free model id ---

# ---------- Neo4j (matches docker-compose.yml) ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexusgraph

# ---------- Pipeline ----------
RSS_FEEDS=https://news.google.com/rss/search?q=semiconductor+supply+chain,https://news.google.com/rss/search?q=chip+shortage+factory,https://news.google.com/rss/search?q=neon+gas+rare+earth+export
MIN_CONFIDENCE=0.6
